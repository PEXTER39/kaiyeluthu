# Copy this file to ".env" and fill it in. The ".env" file stays on your computer / server only.
# Restart `npm run dev` after changing it.

# --- Email (used to send the login OTP code) ---------------------------------
# console = no email is sent; the code is printed in the terminal and shown on the login page (testing only)
# brevo   = free plan sends 300 emails a day; you only need to verify ONE sender email (no domain needed)
# resend  = needs your own domain verified before it can email students
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=Kaiyeluthu
BREVO_API_KEY=
RESEND_API_KEY=

# --- Razorpay (server side check of every payment) ---------------------------
# Leave empty while testing. When you go live, set mockPayments to false in src/config/site.ts
# and fill both values here (the SECRET must never be put in the website code).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Other -------------------------------------------------------------------
API_PORT=8787
# NODE_ENV=production   (set this on the live server: turns off test codes and test payments)
# ALLOWED_ORIGINS=https://yourdomain.com
# DB_FILE=server/data/db.json
